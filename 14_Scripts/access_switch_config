enable

configure terminal

hostname ACCESS-SW01

!
! VLAN creation
!

vlan 10
name MANAGEMENT

vlan 30
name REQUEST

vlan 40
name DATABASE

vlan 50
name OBSERVATION

vlan 60
name PUBLIC

!
! Management SVI
!

interface vlan10
ip address 10.10.10.251 255.255.255.0
no shutdown

ip default-gateway 10.10.10.1

!
! Trunk to Nexus
!

interface TenGigabitEthernet1/1/1
description UPLINK-TO-NEXUS
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 10,20,30,40,50,60
no shutdown

!
! Request Nodes
!

interface GigabitEthernet1/0/1
description REQUEST-NODE-A
switchport mode access
switchport access vlan 30
spanning-tree portfast

interface GigabitEthernet1/0/2
description REQUEST-NODE-B
switchport mode access
switchport access vlan 30
spanning-tree portfast

!
! Database Nodes
!

interface GigabitEthernet1/0/3
description DB-PRIMARY
switchport mode access
switchport access vlan 40
spanning-tree portfast

interface GigabitEthernet1/0/4
description DB-REPLICA-1
switchport mode access
switchport access vlan 40
spanning-tree portfast

interface GigabitEthernet1/0/5
description DB-REPLICA-2
switchport mode access
switchport access vlan 40
spanning-tree portfast

interface GigabitEthernet1/0/6
description DB-REPLICA-3
switchport mode access
switchport access vlan 40
spanning-tree portfast

!
! Observation Nodes
!

interface GigabitEthernet1/0/10
description GRAFANA
switchport mode access
switchport access vlan 50
spanning-tree portfast

interface GigabitEthernet1/0/11
description PROMETHEUS
switchport mode access
switchport access vlan 50
spanning-tree portfast

interface GigabitEthernet1/0/12
description LOKI
switchport mode access
switchport access vlan 50
spanning-tree portfast

!
! Proxmox Management Node
!

interface GigabitEthernet1/0/20
description PROXMOX-MGMT
switchport mode access
switchport access vlan 10
spanning-tree portfast

!
! Public gateway node
!

interface GigabitEthernet1/0/21
description NGINX-PUBLIC
switchport mode access
switchport access vlan 60
spanning-tree portfast

end

write memory

